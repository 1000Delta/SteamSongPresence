<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SteamSongPresence</AssemblyName>
    <Version>0.4.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <GameDir Condition="'$(GameDir)' == ''">$(USERPROFILE)\BSManager\BSInstances\1.40.8</GameDir>
    <IpaLoaderPath Condition="'$(IpaLoaderPath)' == ''">$(GameDir)\Beat Saber_Data\Managed\IPA.Loader.dll</IpaLoaderPath>
    <ModLibDir Condition="'$(ModLibDir)' == ''">$(GameDir)\Libs</ModLibDir>
    <TargetGameVersion Condition="'$(TargetGameVersion)' == ''">1.40.8</TargetGameVersion>
    <ManifestPath Condition="'$(ManifestPath)' == ''">manifest.json</ManifestPath>
    <OutputPath>bin\$(Configuration)\bs$(TargetGameVersion)\</OutputPath>
    <DefineConstants Condition="'$(TargetGameVersion)' == '1.46.0'">$(DefineConstants);BS_146</DefineConstants>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <EmbeddedResource Include="$(ManifestPath)" LogicalName="SteamSongPresence.manifest.json" />
    <Reference Include="IPA.Loader"><HintPath>$(IpaLoaderPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Main"><HintPath>$(GameDir)\Beat Saber_Data\Managed\Main.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Core"><HintPath>$(GameDir)\Beat Saber_Data\Managed\Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DataModels"><HintPath>$(GameDir)\Beat Saber_Data\Managed\DataModels.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HMLib"><HintPath>$(GameDir)\Beat Saber_Data\Managed\HMLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BeatmapCore"><HintPath>$(GameDir)\Beat Saber_Data\Managed\BeatmapCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GameplayCore"><HintPath>$(GameDir)\Beat Saber_Data\Managed\GameplayCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Zenject"><HintPath>$(GameDir)\Beat Saber_Data\Managed\Zenject.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Zenject-usage"><HintPath>$(GameDir)\Beat Saber_Data\Managed\Zenject-usage.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Steamworks.NET" Condition="Exists('$(GameDir)\Beat Saber_Data\Managed\Steamworks.NET.dll')"><HintPath>$(GameDir)\Beat Saber_Data\Managed\Steamworks.NET.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net" Condition="!Exists('$(GameDir)\Beat Saber_Data\Managed\Steamworks.NET.dll')"><HintPath>$(GameDir)\Beat Saber_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ModLibDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ModLibDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
